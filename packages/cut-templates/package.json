{
  "name": "@trackfit/cut-templates",
  "version": "0.3.0-dev",
  "private": true,
  "description": "Trackfit 1:1 print-to-template PDF generator for flex-track cuts. Pure TypeScript, runs in Node and the browser via pdf-lib.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
