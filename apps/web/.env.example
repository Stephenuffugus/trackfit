# Trackfit Premium — set when ready to take payments. Empty values
# disable the corresponding offer (the card renders as "Coming soon").
VITE_PREMIUM_ENABLED=false
VITE_PREMIUM_LIFETIME_PRICE=$29
VITE_PREMIUM_MONTHLY_PRICE=$3/mo
VITE_PREMIUM_LIFETIME_URL=
VITE_PREMIUM_MONTHLY_URL=

# Discord invite URL for tester feedback. Empty value hides the
# "Give feedback on Discord" row in the settings menu.
VITE_DISCORD_FEEDBACK_URL=

# Tally form URL for the deprecated pricing-feedback survey. Optional —
# nothing renders today. Set only if you bring the survey back.
VITE_TALLY_PRICING_URL=

# Set to "true" to route photo-ID through the Cloudflare Worker proxy
# (see /infra/cloudflare-worker/ + /docs/SETUP-PHOTO-ID.md). Without
# this flag, the stub identifier runs and no API spend happens. The
# stub falls back on any fetch error so dev still works even when the
# Worker is unreachable.
VITE_USE_REAL_PHOTO_ID=false

# URL of the deployed Cloudflare Worker (or compatible proxy). Empty
# defaults to "/api/identify-piece" for same-origin / dev-proxied
# setups. Production value looks like
# https://trackfit-vision.your-name.workers.dev
VITE_PHOTO_ID_PROXY_URL=
